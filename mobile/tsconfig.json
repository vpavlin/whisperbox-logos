{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "expo-secure-store": [
        "node_modules/expo-secure-store"
      ],
      "expo-file-system/legacy": [
        "node_modules/expo-file-system/legacy"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "src/lib/loam-transport-pkg/examples",
    "src/lib/loam-transport-pkg/test"
  ]
}
